{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "stai-annur/hero-post-slider",
	"title": "Hero Post Slider",
	"category": "stai-annur",
	"icon": "slides",
	"description": "Slider artikel terbaru STAI An-Nur dengan gambar unggulan dan kategori.",
	"keywords": [ "artikel", "post", "slider", "berita", "terbaru" ],
	"textdomain": "stai-annur",
	"attributes": {
		"sectionTitle": {
			"type": "string",
			"default": "Artikel Terbaru"
		},
		"postsToShow": {
			"type": "number",
			"default": 12
		},
		"imageSize": {
			"type": "string",
			"default": "medium_large"
		},
		"useCustomImageSize": {
			"type": "boolean",
			"default": false
		},
		"customImageWidth": {
			"type": "number",
			"default": 147
		},
		"customImageHeight": {
			"type": "number",
			"default": 98
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
